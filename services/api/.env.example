PRISME_APP_NAME=Prisme API
PRISME_APP_ENV=development
PRISME_DEBUG=false
PRISME_API_V1_PREFIX=/api/v1
PRISME_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PRISME_JWT_SECRET_KEY=generate-a-random-secret-with-at-least-32-characters
PRISME_JWT_ALGORITHM=HS256
PRISME_ACCESS_TOKEN_EXPIRE_MINUTES=30
PRISME_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PRISME_MAX_UPLOAD_BYTES=10485760
PRISME_VERIFICATION_CANDIDATE_LIMIT=1000
PRISME_SIGHTENGINE_API_USER=your-api-user
PRISME_SIGHTENGINE_API_SECRET=your-api-secret
PRISME_SIGHTENGINE_API_URL=https://api.sightengine.com/1.0/check.json
PRISME_SIGHTENGINE_TIMEOUT_SECONDS=20
PRISME_PINATA_JWT=your-pinata-jwt
PRISME_PINATA_GATEWAY=your-gateway.mypinata.cloud
PRISME_PINATA_UPLOAD_URL=https://uploads.pinata.cloud/v3/files
PRISME_PINATA_API_URL=https://api.pinata.cloud/v3
PRISME_PINATA_TIMEOUT_SECONDS=60
PRISME_BASE_RPC_URL=https://sepolia.base.org
PRISME_BASE_CHAIN_ID=84532
PRISME_BASE_EXPLORER_URL=https://sepolia.basescan.org
PRISME_REGISTRY_CONTRACT_ADDRESS=0x12DD566159a151Ab14009BC5d7624519C60c3647
PRISME_REGISTRY_PRIVATE_KEY=your-base-sepolia-private-key
PRISME_BLOCKCHAIN_RECEIPT_TIMEOUT_SECONDS=90
PRISME_C2PA_SIGN_CERT_PATH=tests/fixtures/c2pa/es256_certs.pem
PRISME_C2PA_PRIVATE_KEY_PATH=tests/fixtures/c2pa/es256_private.key
